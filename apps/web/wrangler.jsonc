{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowers-web",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Disable the *.workers.dev URL so flowermarket.lk is the only public origin.
  "workers_dev": false,
  // Apex custom domain — wrangler provisions the DNS record + TLS cert on deploy.
  // www.flowermarket.lk is handled by a zone-level Single Redirect rule (301 → apex),
  // not attached here, so it never serves duplicate content.
  "routes": [
    {
      "pattern": "flowermarket.lk",
      "zone_name": "flowermarket.lk",
      "custom_domain": true
    }
  ]
  // Secrets (set with `wrangler secret put <NAME>` after deploy target exists):
  //   DATABASE_URL           — Supabase transaction pooler (port 6543)
  //   SUPABASE_URL, SUPABASE_ANON_KEY
  //   SITE_URL               — canonical public origin, e.g. https://flowermarket.lk
  //   PAYHERE_MERCHANT_ID, PAYHERE_MERCHANT_SECRET
  //   DOC_ACCESS_SECRET      — HMAC secret for OTP hashing + doc-access cookie signing (>= 32 chars)
  //   EVOLUTION_API_KEY      — Evolution API key for WhatsApp OTP dispatch
  // Non-secret vars (safe to set in wrangler.jsonc vars block if needed):
  //   EVOLUTION_API_URL      — Evolution API base URL, e.g. https://evolution.example.com
  //   EVOLUTION_INSTANCE     — Evolution instance name
}
