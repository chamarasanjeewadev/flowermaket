{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowers-admin",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Smart Placement runs the Worker near Supabase (ap-south-1) instead of at
  // the visitor's edge PoP: each request makes several sequential DB/Auth round
  // trips, so being next to the database beats being next to the browser.
  "placement": { "mode": "smart" },
  // workers_dev:false is required: Cloudflare Access only protects the custom
  // hostname, so leaving the *.workers.dev URL live would bypass Access.
  "workers_dev": false,
  "routes": [{ "pattern": "admin.flowermarket.lk", "custom_domain": true }],
  // Non-secret vars (safe to commit; deploy overrides via wrangler vars or dashboard):
  "vars": {
    "SUPPLIER_PORTAL_URL": "https://supplier.flowermarket.lk",
    "WEB_PUBLIC_URL": "https://flowermarket.lk"
  }
  // Secrets (set with `wrangler secret put <NAME>` after deploy target exists):
  //   DATABASE_URL           — Supabase transaction pooler (port 6543)
  //   SUPABASE_URL, SUPABASE_ANON_KEY
  //   SITE_URL               — canonical public origin, e.g. https://admin.flowermarket.lk
  //   EVOLUTION_API_URL      — base URL of the Evolution API instance
  //   EVOLUTION_API_KEY      — Evolution API key
  //   EVOLUTION_INSTANCE     — Evolution instance name
  //   DOC_ACCESS_SECRET      — HMAC secret for document OTP/cookie signing (≥32 chars)
}
