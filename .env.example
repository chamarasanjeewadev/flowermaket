# ── Supabase ──────────────────────────────────────────────────────────
# Project URL and keys from https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Direct Postgres connection for Drizzle (Settings → Database → Connection string).
# Use the "Transaction" pooler (port 6543) URI for serverless/Workers,
# and the "Session" (5432) URI for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Payments ──────────────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "sandbox" (default) or "live"
PAYHERE_MODE=sandbox
