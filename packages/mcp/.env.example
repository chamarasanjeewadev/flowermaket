# Copy to packages/mcp/.env (gitignored). Values here override the repo-root
# .env, which supplies DATABASE_URL (production Supabase pooler).

# Admin account that agent writes are attributed to (must have role=admin).
FLOWERS_ADMIN_EMAIL=

# Links put into WhatsApp messages — must be the live sites, never localhost.
SUPPLIER_PORTAL_URL=https://supplier.flowermarket.lk
WEB_PUBLIC_URL=https://flowermarket.lk

# Evolution GO (WhatsApp). API key = the instance token, same value as the
# EVOLUTION_API_KEY Cloudflare secret on the admin Worker.
EVOLUTION_API_URL=https://evolution.grittech.lk
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sda

# Optional: 1 = expose only read tools.
# FLOWERS_MCP_READ_ONLY=1
